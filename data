Algorithm sum_distinct
Var
    set1, set2 : array[1..n] of integer
    i, j : integer
    sum : integer
    found : boolean

Begin
    sum ← 0

    // Check set1 elements not in set2
    For i ← 1 to length(set1) do
        found ← false
        For j ← 1 to length(set2) do
            If set1[i] = set2[j] then
                found ← true
        If found = false then
            sum ← sum + set1[i]

    // Check set2 elements not in set1
    For i ← 1 to length(set2) do
        found ← false
        For j ← 1 to length(set1) do
            If set2[i] = set1[j] then
                found ← true
        If found = false then
            sum ← sum + set2[i]

    Write("Sum of distinct elements: ", sum)
End


