// Part 1: Procedure
Procedure dot_product(v1, v2 : array[1..n] of real; VAR ps : real; n : integer)
Var i : integer
Begin
    ps ← 0
    For i ← 1 to n do
        ps ← ps + v1[i] * v2[i]
End


// Part 2: Algorithm checking orthogonality using the procedure above
Algorithm check_orthogonal_pairs
Var
    v1, v2 : array[1..n] of real
    ps : real
    i, k, n, k_pairs : integer

Begin
    Write("Enter number of pairs: ")
    Read(k_pairs)

    For k ← 1 to k_pairs do
        Write("Enter size of vectors: ")
        Read(n)
        For i ← 1 to n do
            Read(v1[i])
        For i ← 1 to n do
            Read(v2[i])

        dot_product(v1, v2, ps, n)

        If ps = 0 then
            Write("Pair ", k, ": Orthogonal")
        Else
            Write("Pair ", k, ": Not orthogonal")
End


// Part 3: Modified version using a function instead of a procedure
Function dot_product(v1, v2 : array[1..n] of real; n : integer) : real
Var i : integer
    ps : real
Begin
    ps ← 0
    For i ← 1 to n do
        ps ← ps + v1[i] * v2[i]
    dot_product ← ps
End

Algorithm check_orthogonal_pairs_v2
Var
    v1, v2 : array[1..n] of real
    i, k, n, k_pairs : integer

Begin
    Write("Enter number of pairs: ")
    Read(k_pairs)

    For k ← 1 to k_pairs do
        Write("Enter size of vectors: ")
        Read(n)
        For i ← 1 to n do
            Read(v1[i])
        For i ← 1 to n do
            Read(v2[i])

        If dot_product(v1, v2, n) = 0 then
            Write("Pair ", k, ": Orthogonal")
        Else
            Write("Pair ", k, ": Not orthogonal")
End



